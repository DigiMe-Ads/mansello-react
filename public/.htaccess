# ---------------------------------------------------------------------------
# Force HTTPS. Must come before the SPA fallback so the redirect happens
# before the rewrite to index.html. The X-Forwarded-Proto check is what makes
# this work behind Hostinger's proxy/load balancer.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Never serve config artefacts, even if one is accidentally uploaded into
# public_html. Without this the SPA fallback below explicitly serves any file
# that exists on disk, so a stray .env would be readable over the web.
# ---------------------------------------------------------------------------
<FilesMatch "(^\.(env|git|htaccess|htpasswd))|(\.(env\..*|map|log)$)|(^package(-lock)?\.json$)">
  Require all denied
</FilesMatch>

# No directory listings.
Options -Indexes

# ---------------------------------------------------------------------------
# SPA fallback for Apache / Hostinger shared hosting.
# Any request that is NOT an existing file or directory is served index.html,
# so React Router can handle deep links like /sri-lanka/blog/my-post directly.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Caching.
#
# Only Vite's fingerprinted output under /assets may be immutable — those
# filenames contain a content hash, so a changed file is always a new URL.
# Files under /images are NOT hashed: marking them immutable means replacing a
# photo is invisible to returning visitors for a year, with no way to force a
# refresh. They get a week with revalidation instead.
#
# index.html must never be cached, or visitors stay pinned to a stale JS bundle.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|avif)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compression. Hostinger usually enables this globally, but stating it here
# means the 650 KB JS bundle is never shipped uncompressed if it doesn't.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_headers.c>
  Header append Vary Accept-Encoding
</IfModule>

# ---------------------------------------------------------------------------
# Security headers.
#
# The CSP origins are derived from what the app actually loads: Stripe
# (src/lib/stripe.ts), the backend API (VITE_API_URL), Google Fonts
# (index.html), and the Google Maps embed on both contact pages.
#
# Deliberate choices, do not "tighten" without reading these:
#   - frame-ancestors 'self' (not 'none'): the admin heatmap viewer frames the
#     site's own public pages in an iframe. 'none' breaks that panel.
#   - payment=(self "https://js.stripe.com"): required for Apple Pay / Google
#     Pay inside Stripe's PaymentElement. Omitting it silently drops them.
#   - style-src 'unsafe-inline': the app sets inline style={{...}} widely
#     (next-image shim, heatmap overlay). Removing it breaks layout.
#   - img-src https:: blog covers and product images are admin-entered URLs.
#     Narrow this to your CDN host once that is fixed.
#
# CSP ships as Report-Only first. Watch the console on /sri-lanka/marketplace
# /checkout and /admin/heatmap, then rename to Content-Security-Policy.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self \"https://js.stripe.com\"), fullscreen=(self \"https://www.google.com\")"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://mansello-backend-production.up.railway.app https://api.stripe.com https://m.stripe.network; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
