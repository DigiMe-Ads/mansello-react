# Base URL of the backend API (no trailing slash)
VITE_API_URL=https://your-backend.example.com

# Stripe publishable keys (test or live) per account
VITE_STRIPE_PK_ITALY=pk_test_xxx
VITE_STRIPE_PK_SRILANKA=pk_test_xxx

# Sri Lanka payments are moving to Payments.lk (hosted checkout). The Payments.lk
# secret key is SERVER-ONLY: it lives in the backend .env, never here with a VITE_
# prefix. The frontend needs no Payments.lk key.
